/* Placeholder for demo thumbnail - optimized SVG */
<svg width="640" height="360" viewBox="0 0 640 360" xmlns="http://www.w3.org/2000/svg">
  <rect width="640" height="360" fill="#1a1a2e" />
  
  <!-- Video player elements -->
  <rect x="20" y="20" width="600" height="320" rx="8" fill="#2a2a3e" />
  
  <!-- iLEAPP AI interface mockup -->
  <rect x="40" y="50" width="560" height="260" rx="4" fill="#ffffff" />
  
  <!-- Toolbar -->
  <rect x="40" y="50" width="560" height="30" rx="4" fill="#4a6bff" />
  <circle cx="55" cy="65" r="5" fill="#ff3b30" />
  <circle cx="70" cy="65" r="5" fill="#ff9500" />
  <circle cx="85" cy="65" r="5" fill="#34c759" />
  
  <!-- Sidebar -->
  <rect x="40" y="80" width="140" height="230" fill="#f5f7ff" />
  
  <!-- Sidebar items -->
  <rect x="50" y="100" width="120" height="20" rx="4" fill="#4a6bff" opacity="0.7" />
  <rect x="50" y="130" width="120" height="20" rx="4" fill="#e1e4f2" />
  <rect x="50" y="160" width="120" height="20" rx="4" fill="#e1e4f2" />
  <rect x="50" y="190" width="120" height="20" rx="4" fill="#e1e4f2" />
  <rect x="50" y="220" width="120" height="20" rx="4" fill="#e1e4f2" />
  <rect x="50" y="250" width="120" height="20" rx="4" fill="#e1e4f2" />
  
  <!-- Main content area -->
  <rect x="190" y="90" width="400" height="210" fill="#ffffff" />
  
  <!-- Data visualization -->
  <rect x="210" y="110" width="360" height="40" rx="4" fill="#e1e4f2" />
  
  <!-- Timeline visualization -->
  <rect x="210" y="170" width="360" height="80" rx="4" fill="#e1e4f2" />
  <circle cx="250" cy="210" r="8" fill="#4a6bff" />
  <circle cx="310" cy="210" r="8" fill="#34c759" />
  <circle cx="370" cy="210" r="8" fill="#ff9500" />
  <circle cx="430" cy="210" r="8" fill="#5ac8fa" />
  <circle cx="490" cy="210" r="8" fill="#4a6bff" />
  
  <!-- Connection lines -->
  <line x1="250" y1="210" x2="310" y2="210" stroke="#8a8a9a" stroke-width="2" />
  <line x1="310" y1="210" x2="370" y2="210" stroke="#8a8a9a" stroke-width="2" />
  <line x1="370" y1="210" x2="430" y2="210" stroke="#8a8a9a" stroke-width="2" />
  <line x1="430" y1="210" x2="490" y2="210" stroke="#8a8a9a" stroke-width="2" />
  
  <!-- Play button overlay -->
  <circle cx="320" cy="180" r="40" fill="#4a6bff" opacity="0.9" />
  <polygon points="310,160 310,200 340,180" fill="white" />
</svg>
